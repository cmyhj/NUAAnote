# ====================
# Obsidian 配置文件
# ====================
# 工作区文件（包含打开的标签页、布局等个人状态）
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# 插件数据文件（包含个人设置，会频繁变化）
.obsidian/plugins/*/data.json

# 插件脚本（可重新下载）
.obsidian/plugins/obsidian-git/obsidian_askpass.sh

# ====================
# Obsidian 系统目录
# ====================
# Obsidian 回收站
.trash/

# ====================
# 开发工具配置
# ====================
.sisyphus/

# ====================
# 操作系统生成的文件
# ====================
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ====================
# 常见临时文件
# ====================
*.log
*.tmp
*.bak
*.cache
*.pyc
*.pyo
__pycache__/
*.swp
*.swo
*~
.vscode/
.idea/

# ====================
# Node.js（如果使用）
# ====================
node_modules/
package-lock.json
yarn.lock

# ====================
# 其他
# ====================
*.excalidraw
*.excalidraw.md